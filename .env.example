# Local SQLite database
DATABASE_URL="file:./dev.db"

# Optional Microsoft Entra ID application credentials.
# Leave BOTH empty for login-free local mode (bound to 127.0.0.1 only).
# Set BOTH to require Microsoft sign-in. Setting only one is an error.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Advanced opt-in: Work Board's OWN Microsoft Entra public-client Application ID.
# SDK only: used by its Copilot host for MCP company-account sign-in and renewal.
# Separate from website login above; no client secret or MCP token is needed.
# Native CLI runs use their own authentication and do not read this setting.
# Empty leaves the SDK Entra authentication limitation in place.
# Only configure an approved registration; restart and open a new runtime to apply.
WORKBOARD_COPILOT_ENTRA_CLIENT_ID=""

# Required in Entra mode. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Browser-reachable root URL for authentication and desktop-notification links.
AUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

# Optional: use either token for headless GitHub Copilot CLI authentication
GH_TOKEN=""
# GITHUB_TOKEN=""

# Optional runtime settings
RUN_CONCURRENCY="5"
CODEBOARD_PREVENT_SLEEP="true"

# Current-user login startup after a successful background:start/restart.
# Defaults to true when unset. background:stop removes the owned startup entry.
# false still allows manual startup; login never builds or migrates the database.
WORKBOARD_AUTOSTART="true"

# Show the Skill comparison creation UI on eligible Work pages.
# Hidden by default, including when unset. Restart after changing this value.
# Existing comparison results and experiment APIs remain available.
WORKBOARD_SHOW_SKILL_COMPARISON="false"

# Optional local Windows Terminal integration. localhost access works by default.
# Set this only when a trusted non-localhost deployment should be allowed to open a terminal
# on the server machine. WORKBOARD_LOCAL_URL must remain reachable from that same machine.
WORKBOARD_ENABLE_LOCAL_TERMINAL="false"
WORKBOARD_LOCAL_URL="http://127.0.0.1:3100"