// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum RepoSourceType {
  LOCAL_PATH
  GIT_URL
}

enum TriggerType {
  MANUAL
  SCHEDULE
  WEBHOOK
  API
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  CANCELLED
}

enum RunTrigger {
  MANUAL
  SCHEDULE
  WEBHOOK
  API
  WORK
  TERMINAL_START
  TERMINAL_RESUME
  EXPERIMENT
  FOLLOW_UP
}

enum ExperimentStatus {
  PROVISIONING
  RUNNING
  COMPLETED
  FAILED
}

enum ExperimentVariantStatus {
  COPYING
  READY
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum SkillInvocationMode {
  EXPLICIT
  AUTO
}

enum TerminalLaunchStatus {
  PENDING
  LAUNCHED
  SYNCING
  COMPLETED
  FAILED
}

enum WorkStatus {
  ACTIVE
  REVIEW
  ARCHIVED
}

enum WorkEngine {
  CLI
  SDK
}

model Repo {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sourceType  RepoSourceType
  // Absolute local path (LOCAL_PATH) or git remote URL (GIT_URL)
  location    String
  defaultBranch String       @default("main")
  // Hostname of the machine this app was running on when the repo was registered — since the
  // Copilot CLI runs on whatever host serves this app, this disambiguates repos across machines
  // when the same account is used to sign in from multiple locations/deployments.
  hostname    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tasks       Task[]
  webhooks    WebhookConfig[]
  sourceWorks Work[]         @relation("WorkSourceRepo")

  @@unique([userId, sourceType, location])
  @@index([userId])
}

model Task {
  id              String        @id @default(cuid())
  name            String
  repoId          String
  repo            Repo          @relation(fields: [repoId], references: [id], onDelete: Cascade)
  workId          String?
  work            Work?         @relation(fields: [workId], references: [id], onDelete: SetNull)
  prompt          String
  agent           String?
  model           String?
  fallbackModel   String?
  // Copilot CLI --context: "default" | "long_context"
  contextTier     String?
  // Copilot CLI --effort/--reasoning-effort: "none" | "minimal" | "low" | "medium" | "high" | "xhigh" | "max"
  reasoningEffort String?
  // Copilot CLI permission mode, e.g. "allow-all" | "default"
  permissionMode  String        @default("default")
  // Copilot CLI --output-format: "text" (readable) or "json" (raw JSONL event stream)
  outputFormat    String        @default("text")
  triggerType     TriggerType
  cronExpression  String?
  // Comma-separated GitHub event types this task responds to when triggerType = WEBHOOK
  webhookEvents   String?
  enabled         Boolean       @default(true)
  // Create a fresh branch per run instead of touching the default branch directly
  useSafeBranch   Boolean       @default(true)
  // Wait for every earlier queued/running Run before starting, and block later Runs until done.
  waitForPreviousRuns Boolean   @default(false)
  timeoutSeconds  Int           @default(1800)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  runs            Run[]

  @@index([repoId])
  @@index([workId])
  // Speeds up the scheduler's 30s reconciliation query and the webhook receiver's task lookup,
  // both of which filter by triggerType + enabled.
  @@index([triggerType, enabled])
  @@index([repoId, triggerType, enabled])
}

model Work {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRepoId   String?
  sourceRepo     Repo?        @relation("WorkSourceRepo", fields: [sourceRepoId], references: [id], onDelete: SetNull)
  name           String
  directoryPath  String
  canonicalPath  String
  promptFileName String       @default("PROMPT.md")
  promptCache    String       @default("")
  promptHash     String?
  hostname       String?
  status         WorkStatus   @default(ACTIVE)
  defaultEngine  WorkEngine   @default(CLI)
  agent          String?
  model          String?
  fallbackModel  String?
  contextTier    String?
  reasoningEffort String?
  permissionMode String       @default("default")
  outputFormat   String       @default("text")
  timeoutSeconds Int?
  position       Int          @default(0)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tasks          Task[]
  runs           Run[]
  experiments    Experiment[]

  @@unique([userId, canonicalPath, promptFileName])
  @@index([userId, status, updatedAt])
  @@index([userId, status, position])
  @@index([sourceRepoId])
}

model WorkPathShortcut {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  rootPath   String
  position   Int      @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, rootPath])
  @@index([userId, position])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  content     String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, position])
}

model Run {
  id           String     @id @default(cuid())
  taskId       String?
  task         Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workId       String?
  work         Work?      @relation(fields: [workId], references: [id], onDelete: Cascade)
  experimentVariantId String?
  experimentVariant ExperimentVariant? @relation(fields: [experimentVariantId], references: [id], onDelete: SetNull)
  status       RunStatus  @default(PENDING)
  trigger      RunTrigger
  engine       WorkEngine?
  executionPath String?
  promptSnapshot String?
  finalOutput  String?
  outputDir    String?
  copilotSessionId String?
  concurrencyMode String?
  resumedFromRunId String?
  resumedFromRun Run?       @relation("RunResumes", fields: [resumedFromRunId], references: [id], onDelete: SetNull)
  resumedRuns    Run[]      @relation("RunResumes")
  branchName   String?
  // Commit SHA of the default branch right before this run started (captured after syncing to
  // it, before any safe branch is created) — lets getRunDiff compute a two-ref diff without
  // ever checking anything out, whether the run committed to its own branch or straight to the
  // default branch (when useSafeBranch is off).
  baseCommit   String?
  // Best-effort HEAD commit captured when a started run reaches a terminal state. Together with
  // baseCommit, this freezes the committed diff so later branch updates cannot change it.
  finalCommit  String?
  logPath      String?
  // Output format actually used for this run (copied from the Task at start time, since the
  // Task's setting could change later and the log's format shouldn't be reinterpreted).
  outputFormat String?
  // Model / context tier / reasoning effort actually used for this run, copied from the Task at
  // start time for the same reason as outputFormat above.
  agent           String?
  model           String?
  fallbackModel   String?
  contextTier     String?
  reasoningEffort String?
  permissionMode  String?
  timeoutSeconds  Int?
  exitCode     Int?
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime   @default(now())
  // Process info, best-effort — populated when the copilot CLI child process spawns/exits.
  pid          Int?
  command      String?
  // Cumulative CPU time in ms and last-observed resident memory, from the most recent
  // pidusage sample taken while the process was alive (not available after the process exits).
  cpuTimeMs    Int?
  peakMemoryMb Float?
  // Copilot session shutdown usage for this Run. inputTokens includes cached input;
  // cacheReadTokens/cacheWriteTokens provide the corresponding breakdown.
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  reasoningTokens  Int?
  modelsUsed       String?
  notificationClaimedAt    DateTime?
  notificationSentAt       DateTime?
  notificationSuppressedAt DateTime?
  notificationError        String?
  // Hostname of the machine that actually executed this run (set once it starts) — a PENDING run
  // that hasn't started yet has no value here; fall back to the task's repo hostname in the UI.
  hostname     String?
  terminalLaunches TerminalLaunch[]

  @@index([taskId])
  @@index([workId, createdAt])
  @@index([status, createdAt])
  @@index([resumedFromRunId])
  @@index([experimentVariantId])
  @@index([notificationClaimedAt, finishedAt])
}

model Experiment {
  id             String              @id @default(cuid())
  workId         String
  work           Work                @relation(fields: [workId], references: [id], onDelete: Cascade)
  name           String
  invocationMode SkillInvocationMode @default(EXPLICIT)
  engine         WorkEngine          @default(CLI)
  status         ExperimentStatus    @default(PROVISIONING)
  basePath       String?
  errorMessage   String?
  finishedAt     DateTime?
  notificationClaimedAt    DateTime?
  notificationSentAt       DateTime?
  notificationSuppressedAt DateTime?
  notificationError        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  variants       ExperimentVariant[]

  @@index([workId, createdAt])
  @@index([notificationClaimedAt, finishedAt])
}

model ExperimentVariant {
  id              String                  @id @default(cuid())
  experimentId    String
  experiment      Experiment              @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  skillName       String?
  skillSourcePath String?
  skillHash       String?
  directoryPath   String?
  status          ExperimentVariantStatus @default(COPYING)
  skillInvoked    Boolean?
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  runs            Run[]

  @@index([experimentId, status])
}

model TerminalLaunch {
  id          String               @id @default(cuid())
  runId       String               @unique
  run         Run                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  tokenHash   String               @unique
  status      TerminalLaunchStatus @default(PENDING)
  launcherPid Int?
  expiresAt   DateTime
  launchedAt  DateTime?
  completedAt DateTime?
  errorMessage String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, expiresAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // SHA-256 hash of the token; the raw token is only shown once at creation time
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model WebhookConfig {
  id            String   @id @default(cuid())
  repoId        String   @unique
  repo          Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  // Shared secret used to verify the GitHub webhook HMAC signature (must be readable to
  // compute/verify HMAC, unlike a login password — treat this DB file as sensitive).
  secret        String
  createdAt     DateTime @default(now())

  @@index([repoId])
}

// --- Auth.js (NextAuth) models, required shape for @auth/prisma-adapter ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  repos         Repo[]
  apiTokens     ApiToken[]
  works         Work[]
  workPathShortcuts WorkPathShortcut[]
  promptTemplates PromptTemplate[]
  executionSettings UserExecutionSettings?
}

model UserExecutionSettings {
  id                    String     @id @default(cuid())
  userId                String     @unique
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultEngine         WorkEngine @default(CLI)
  agent                 String?
  model                 String?
  fallbackModel         String?
  contextTier           String?
  reasoningEffort       String?
  permissionMode        String     @default("default")
  outputFormat          String     @default("text")
  workTimeoutSeconds    Int?
  automationTimeoutSeconds Int     @default(1800)
  useSafeBranch         Boolean    @default(true)
  waitForPreviousRuns   Boolean    @default(false)
  systemNotificationsEnabled Boolean @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
