    "@github/copilot-sdk": "^1.0.11",
    "@prisma/adapter-better-sqlite3": "7.9.0",
    "@prisma/client": "^7.9.0",
    "cron-parser": "^5.6.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "pidusage": "^4.0.1",
